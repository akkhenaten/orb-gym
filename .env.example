# Orb Gym configuration inventory — example names only; no runtime selected.
# These blank values do not create a working environment.
# Confirm exact variable names and automatic OpenKBS injection with the builder.
# Never put real secrets in this file or expose backend values to a client bundle.

# Non-secret environment and canonical application URL
APP_ENV=
APP_BASE_URL=

# Server-side capabilities; may be auto-injected or replaced by chosen services
DATABASE_URL=
PRIVATE_STORAGE_BUCKET=
SESSION_SECRET=

# Outbound email: requires a verified sender and configured delivery adapter
EMAIL_FROM_ADDRESS=

# Do not invent Stripe/DD/payroll/map/AI credentials here.
